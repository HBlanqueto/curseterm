From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 23:30:00 +0000
Subject: [PATCH] feat(kit): TextField::auto_focus como SearchField
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Una hoja con un solo campo, como renombrar una pestaña, necesita que el
campo tome el foco al abrirse. SearchField ya lo permite; TextField no.
Lo nota CurseTerm (BK-029).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01F89v1xFeQ2WCVD25PBsobh
---
diff --git a/crates/barrier-kit/src/controls.rs b/crates/barrier-kit/src/controls.rs
index 82cb565..1dbc867 100644
--- a/crates/barrier-kit/src/controls.rs
+++ b/crates/barrier-kit/src/controls.rs
@@ -806,6 +806,7 @@ pub struct TextField {
     value: State<String>,
     placeholder: &'static str,
     width: Size,
+    auto_focus: bool,
     key: DiffKey,
 }
 
@@ -815,6 +816,7 @@ impl TextField {
             value,
             placeholder,
             width: Size::fill(),
+            auto_focus: false,
             key: DiffKey::None,
         }
     }
@@ -823,6 +825,11 @@ impl TextField {
         self.width = width;
         self
     }
+
+    pub fn auto_focus(mut self, auto_focus: bool) -> Self {
+        self.auto_focus = auto_focus;
+        self
+    }
 }
 
 impl KeyExt for TextField {
@@ -841,7 +848,8 @@ impl Component for TextField {
             palette.separator,
             TEXT_FIELD.radius,
             TEXT_FIELD.padding_x,
-        );
+        )
+        .auto_focus(self.auto_focus);
         text_style(rect().width(self.width.clone())).child(input)
     }
 }
diff --git a/docs/barrierkit/05-controles.en.md b/docs/barrierkit/05-controles.en.md
index 3707b4c..247c215 100644
--- a/docs/barrierkit/05-controles.en.md
+++ b/docs/barrierkit/05-controles.en.md
@@ -131,7 +131,8 @@ SecureField::new(clave).on_submit(move |valor| entrar(valor))
 
 `TextField` and `SearchField` write directly into a `State<String>`. With the
 focus in a field, Ctrl+A, C, V, X, Y and Z belong to the field before the menu.
-`SearchField::auto_focus(true)` takes the focus when it mounts.
+`TextField::auto_focus(true)` and `SearchField::auto_focus(true)` take the
+focus when they mount.
 
 `SecureField` keeps the password in a `State<PasswordField>`
 (`barrier_kit::password`) that the app creates. Enter calls `on_submit` with the
diff --git a/docs/barrierkit/05-controles.md b/docs/barrierkit/05-controles.md
index 1f83683..35e544c 100644
--- a/docs/barrierkit/05-controles.md
+++ b/docs/barrierkit/05-controles.md
@@ -130,7 +130,8 @@ SecureField::new(clave).on_submit(move |valor| entrar(valor))
 
 `TextField` y `SearchField` escriben directamente en un `State<String>`. Con
 el foco en un campo, Ctrl+A, C, V, X, Y y Z son del campo antes que del menú.
-`SearchField::auto_focus(true)` toma el foco al montarse.
+`TextField::auto_focus(true)` y `SearchField::auto_focus(true)` toman el foco
+al montarse.
 
 `SecureField` guarda la contraseña en un `State<PasswordField>`
 (`barrier_kit::password`) que crea la app. Enter llama a `on_submit` con el
