From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 00:30:00 +0000
Subject: [PATCH] feat(kit): WindowControls::open_window
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

El runner ya guarda varias ventanas y solo termina al cerrar la última,
pero create_window es interna y run_window abre una sola. La orden abre
otra ventana en el mismo proceso desde la app. Lo nota CurseTerm (BK-001).

Al cerrar una ventana, close_window escribía el estado con la lectura aún
prestada (status.set con ..*status.read()) y el runner entraba en pánico;
con una sola ventana por proceso no se notaba porque el proceso terminaba.
Ahora usa la copia que ya había leído.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01F89v1xFeQ2WCVD25PBsobh
---
diff --git a/crates/barrier-kit/src/platform/window.rs b/crates/barrier-kit/src/platform/window.rs
index 42e9517..df06b8c 100644
--- a/crates/barrier-kit/src/platform/window.rs
+++ b/crates/barrier-kit/src/platform/window.rs
@@ -228,6 +228,13 @@ impl WindowControls {
         self.ping.ping();
     }
 
+    pub fn open_window(&self, app: AppComponent, options: WindowOptions) {
+        self.queue
+            .borrow_mut()
+            .push(WindowCommand::Open(Box::new((app, options))));
+        self.ping.ping();
+    }
+
     pub fn set_background_alpha(&self, alpha: f32) {
         self.queue
             .borrow_mut()
@@ -278,6 +285,7 @@ pub(crate) enum WindowCommand {
     SetTitle(String),
     Toolbar,
     BackgroundAlpha(f32),
+    Open(Box<(AppComponent, WindowOptions)>),
 }
 
 pub(super) fn resize_edge(edge: WindowEdge) -> xdg_toplevel::ResizeEdge {
@@ -537,6 +545,11 @@ impl Runtime {
                     self.close_window(context.controls.surface_id.clone());
                     continue;
                 }
+                if let WindowCommand::Open(window) = command {
+                    let (app, options) = *window;
+                    self.create_window(app, options);
+                    continue;
+                }
                 let Some(index) = self.surfaces.iter().position(|surface| {
                     matches!(surface.role, SurfaceRole::Window(_))
                         && surface.surface.id() == context.controls.surface_id
@@ -588,7 +601,9 @@ impl Runtime {
                             style.set_toolbar(window.wl_surface());
                         }
                     }
-                    WindowCommand::Close | WindowCommand::BackgroundAlpha(_) => unreachable!(),
+                    WindowCommand::Close
+                    | WindowCommand::BackgroundAlpha(_)
+                    | WindowCommand::Open(_) => unreachable!(),
                 }
                 self.surfaces[index].needs_redraw = true;
             }
@@ -730,7 +745,7 @@ impl Runtime {
             }
             status.set(WindowStatus {
                 activated: false,
-                ..*status.read()
+                ..shown
             });
         }
         if !self.needs_exit
diff --git a/docs/barrierkit/06-ventanas.en.md b/docs/barrierkit/06-ventanas.en.md
index bb6ea22..31c3bee 100644
--- a/docs/barrierkit/06-ventanas.en.md
+++ b/docs/barrierkit/06-ventanas.en.md
@@ -31,7 +31,8 @@ Inside the app, `WindowControls::get()` gives the state (`activated`,
 `maximized`, `fullscreen`, `decoration`, `fixed`) and the commands: `close()`,
 `minimize()`, `toggle_maximize()`, `toggle_fullscreen()`, `move_window()`,
 `resize(WindowEdge)`, `set_title(title)`, which changes the title the compositor and the menu bar see, and
-`set_background_alpha(alpha)`, which multiplies the alpha of the background the runner clears the window with (1 is opaque).
+`set_background_alpha(alpha)`, which multiplies the alpha of the background the runner clears the window with (1 is opaque), and
+`open_window(app, options)`, which opens another window in the same process; the process ends when the last one closes.
 
 ## Window state
 
diff --git a/docs/barrierkit/06-ventanas.md b/docs/barrierkit/06-ventanas.md
index 7953da5..5476a84 100644
--- a/docs/barrierkit/06-ventanas.md
+++ b/docs/barrierkit/06-ventanas.md
@@ -31,7 +31,8 @@ Dentro de la app, `WindowControls::get()` da el estado (`activated`,
 `maximized`, `fullscreen`, `decoration`, `fixed`) y las órdenes: `close()`,
 `minimize()`, `toggle_maximize()`, `toggle_fullscreen()`, `move_window()`,
 `resize(WindowEdge)`, `set_title(título)`, que cambia el título que ven el compositor y la barra de menús, y
-`set_background_alpha(alfa)`, que multiplica el alfa del fondo con que el runner limpia la ventana (1 es opaco).
+`set_background_alpha(alfa)`, que multiplica el alfa del fondo con que el runner limpia la ventana (1 es opaco), y
+`open_window(app, opciones)`, que abre otra ventana en el mismo proceso; el proceso termina al cerrarse la última.
 
