From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 23:50:00 +0000
Subject: [PATCH] feat(kit): WindowControls::set_background_alpha
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

El runner limpia cada ventana con el fondo de la apariencia global y la
app no puede pedir uno translúcido. La orden multiplica el alfa de ese
fondo; con alfa menor que 1 la región deja de declararse opaca. Lo nota
CurseTerm (BK-031).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01F89v1xFeQ2WCVD25PBsobh
---
diff --git a/crates/barrier-kit/src/platform/surface.rs b/crates/barrier-kit/src/platform/surface.rs
index 21fd13a..a743671 100644
--- a/crates/barrier-kit/src/platform/surface.rs
+++ b/crates/barrier-kit/src/platform/surface.rs
@@ -50,6 +50,7 @@ pub(crate) struct SurfaceWindow {
     pub(crate) frame_pending: bool,
     pub(crate) draw_count: u64,
     pub(crate) opaque_size: Option<(u32, u32)>,
+    pub(crate) background_alpha: f32,
     pub(crate) pending_configure: Option<(WindowConfigure, u32)>,
     pub(crate) appmenu: Option<OrgKdeKwinAppmenu>,
     pub(crate) appmenu_address: Option<AppMenuAddress>,
@@ -165,10 +166,12 @@ impl SurfaceWindow {
         let _draw = tracing::trace_span!("draw").entered();
         let background = if matches!(&self.role, SurfaceRole::Window(_)) {
             let resolved = *self.app.resolved.read();
-            crate::theme::color(crate::theme::surface_background(
-                &resolved,
-                crate::theme::SurfaceKind::Toplevel,
-            ))
+            let base =
+                crate::theme::surface_background(&resolved, crate::theme::SurfaceKind::Toplevel);
+            crate::theme::color(vow_design::Rgba {
+                a: base.a * self.background_alpha,
+                ..base
+            })
         } else {
             Color::TRANSPARENT
         };
@@ -294,6 +297,7 @@ impl Runtime {
             frame_pending: false,
             draw_count: 0,
             opaque_size: None,
+            background_alpha: 1.0,
             pending_configure: None,
             appmenu: None,
             appmenu_address: None,
diff --git a/crates/barrier-kit/src/platform/window.rs b/crates/barrier-kit/src/platform/window.rs
index 484b5db..42e9517 100644
--- a/crates/barrier-kit/src/platform/window.rs
+++ b/crates/barrier-kit/src/platform/window.rs
@@ -228,6 +228,13 @@ impl WindowControls {
         self.ping.ping();
     }
 
+    pub fn set_background_alpha(&self, alpha: f32) {
+        self.queue
+            .borrow_mut()
+            .push(WindowCommand::BackgroundAlpha(alpha.clamp(0.0, 1.0)));
+        self.ping.ping();
+    }
+
     pub fn minimize(&self) {
         self.queue.borrow_mut().push(WindowCommand::Minimize);
         self.ping.ping();
@@ -270,6 +277,7 @@ pub(crate) enum WindowCommand {
     Present(String),
     SetTitle(String),
     Toolbar,
+    BackgroundAlpha(f32),
 }
 
 pub(super) fn resize_edge(edge: WindowEdge) -> xdg_toplevel::ResizeEdge {
@@ -535,6 +543,11 @@ impl Runtime {
                 }) else {
                     continue;
                 };
+                if let WindowCommand::BackgroundAlpha(alpha) = command {
+                    self.surfaces[index].background_alpha = alpha;
+                    self.surfaces[index].needs_redraw = true;
+                    continue;
+                }
                 let SurfaceRole::Window(window) = &self.surfaces[index].role else {
                     continue;
                 };
@@ -575,7 +588,7 @@ impl Runtime {
                             style.set_toolbar(window.wl_surface());
                         }
                     }
-                    WindowCommand::Close => unreachable!(),
+                    WindowCommand::Close | WindowCommand::BackgroundAlpha(_) => unreachable!(),
                 }
                 self.surfaces[index].needs_redraw = true;
             }
diff --git a/docs/barrierkit/06-ventanas.en.md b/docs/barrierkit/06-ventanas.en.md
index 0959587..bb6ea22 100644
--- a/docs/barrierkit/06-ventanas.en.md
+++ b/docs/barrierkit/06-ventanas.en.md
@@ -30,7 +30,8 @@ run_window(
 Inside the app, `WindowControls::get()` gives the state (`activated`,
 `maximized`, `fullscreen`, `decoration`, `fixed`) and the commands: `close()`,
 `minimize()`, `toggle_maximize()`, `toggle_fullscreen()`, `move_window()`,
-`resize(WindowEdge)` and `set_title(title)`, which changes the title the compositor and the menu bar see.
+`resize(WindowEdge)`, `set_title(title)`, which changes the title the compositor and the menu bar see, and
+`set_background_alpha(alpha)`, which multiplies the alpha of the background the runner clears the window with (1 is opaque).
 
 ## Window state
 
diff --git a/docs/barrierkit/06-ventanas.md b/docs/barrierkit/06-ventanas.md
index 8b55307..7953da5 100644
--- a/docs/barrierkit/06-ventanas.md
+++ b/docs/barrierkit/06-ventanas.md
@@ -30,7 +30,8 @@ run_window(
 Dentro de la app, `WindowControls::get()` da el estado (`activated`,
 `maximized`, `fullscreen`, `decoration`, `fixed`) y las órdenes: `close()`,
 `minimize()`, `toggle_maximize()`, `toggle_fullscreen()`, `move_window()`,
-`resize(WindowEdge)` y `set_title(título)`, que cambia el título que ven el compositor y la barra de menús.
+`resize(WindowEdge)`, `set_title(título)`, que cambia el título que ven el compositor y la barra de menús, y
+`set_background_alpha(alfa)`, que multiplica el alfa del fondo con que el runner limpia la ventana (1 es opaco).
 
 ## Estado de la ventana
 
